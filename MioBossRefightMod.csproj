<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PolyHook2.NET" Version="1.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MioModdingApi">
      <HintPath>../lib/MioModdingApi.dll</HintPath>
			<Private>false</Private>
    </Reference>
    <Reference Include="MioModLoader">
      <HintPath>../lib/MioModLoader.dll</HintPath>
			<Private>false</Private>
    </Reference>
    <Reference Include="MioBinds">
      <HintPath>../lib/MioBinds.dll</HintPath>
			<Private>false</Private>
    </Reference>
  </ItemGroup>
	
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Condition="$(OS) == 'Windows_NT'" Command="call &quot;$(ProjectDir)post-build.bat&quot; &quot;$(TargetPath)&quot; &quot;$(ProjectName)&quot; &quot;$(TargetDir)&quot;" WorkingDirectory="$(ProjectDir)" />
		<Exec Condition="$(OS) == 'Unix'" Command="/bin/sh ./post-build.sh" />
	</Target>

</Project>
